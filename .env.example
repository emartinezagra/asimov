TELEGRAM_TOKEN=replace-with-your-botfather-token
OLLAMA_URL=http://127.0.0.1:11434
# How long Ollama keeps the model loaded in memory after each use
# (avoids slow reloads between messages). Use "-1" to never unload it.
OLLAMA_KEEP_ALIVE=30m
CHAT_MODEL=llama3.2:3b
# brief | technical | balanced (see response_styles.py)
RESPONSE_STYLE=balanced
DB_PATH=./conversations.db
# DEBUG to see the full prompt sent to Ollama in logs/asimov.log
LOG_LEVEL=INFO

# IANA timezone used to resolve "mañana a las 9", "en 10 minutos", etc.
TIMEZONE=Europe/Madrid

# Name:email pairs so the assistant can send emails without ever inventing
# an address (e.g. "Juan:juan@example.com,Maria:maria@example.com").
CONTACTS=

# SMTP credentials for sending email. Leave EMAIL_SMTP_HOST empty to disable
# sending (drafts still get created, sending just fails with a clear error).
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=

# Default city for weather questions that don't name one. Uses Open-Meteo,
# free and keyless.
DEFAULT_LOCATION=

# Base URL of a SearXNG instance for WEB_SEARCH (e.g. http://localhost:8080).
# Its settings.yml needs "json" enabled under search.formats. Leave empty to
# disable web search (the bot will say so instead of failing silently).
SEARXNG_URL=
