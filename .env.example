TELEGRAM_TOKEN=replace-with-your-botfather-token
OLLAMA_URL=http://127.0.0.1:11434
# How long Ollama keeps the model loaded in memory after each use
# (avoids slow reloads between messages). Use "-1" to never unload it.
OLLAMA_KEEP_ALIVE=30m
CHAT_MODEL=llama3.2:3b
# brief | technical | balanced (see response_styles.py)
RESPONSE_STYLE=balanced
DB_PATH=./conversations.db
# DEBUG to see the full prompt sent to Ollama in logs/asimov.log
LOG_LEVEL=INFO
