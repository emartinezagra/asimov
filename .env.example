TELEGRAM_TOKEN=replace-with-your-botfather-token
OLLAMA_URL=http://127.0.0.1:11434
# Tiempo que Ollama mantiene el modelo cargado en memoria tras cada uso
# (evita recargas lentas entre mensajes). Usa "-1" para no descargarlo nunca.
OLLAMA_KEEP_ALIVE=30m
CHAT_MODEL=llama3.2:3b
# brief | technical | balanced (ver response_styles.py)
RESPONSE_STYLE=balanced
DB_PATH=./conversations.db
# DEBUG para ver el prompt completo enviado a Ollama en logs/asimov.log
LOG_LEVEL=INFO
